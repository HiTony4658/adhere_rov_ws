<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    ros2_control contract for AdhereMujocoHardware (ROS 2 Foxy hardware_interface::SystemInterface).
    8 command_interface (thruster effort) + 55 state_interface, matching CLAUDE.md Sec.3/4 and
    this package's README interface table exactly:
      - 8  thruster effort readback
      - 10 imu_sensor      (orientation.w/x/y/z, angular_velocity.x/y/z, linear_acceleration.x/y/z), ground truth
      - 10 rov_odom        (pos.x/y/z, quat.w/x/y/z, vel_body.x/y/z), ground truth
      - 8  pad_contact     (pad_*/force x4, pad_*/v_sep x4), ground truth
      - 10 imu_sensor_noisy    (same layout as imu_sensor, 500Hz noisy IMU)
      - 1  depth_sensor_noisy (z, 50Hz sample-and-hold noisy depth)
      - 4  dvl_sensor_noisy   (vel.x/y/z + range, 20Hz sample-and-hold noisy DVL)
      - 4  loadcell_noisy     (pad_*/force x4, 500Hz noisy load cells)
    (Phase 3.5, CLAUDE.md dual state-acquisition: ground_truth vs sensor_fusion.)
  -->
  <ros2_control name="AdhereMujocoSystem" type="system">
    <hardware>
      <plugin>adhere_mujoco_hardware/AdhereMujocoHardware</plugin>
    </hardware>

    <joint name="thr_N1">
      <command_interface name="effort">
        <param name="min">-40.0</param>
        <param name="max">40.0</param>
      </command_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="thr_N2">
      <command_interface name="effort">
        <param name="min">-40.0</param>
        <param name="max">40.0</param>
      </command_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="thr_N3">
      <command_interface name="effort">
        <param name="min">-40.0</param>
        <param name="max">40.0</param>
      </command_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="thr_N4">
      <command_interface name="effort">
        <param name="min">-40.0</param>
        <param name="max">40.0</param>
      </command_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="thr_T5">
      <command_interface name="effort">
        <param name="min">-40.0</param>
        <param name="max">40.0</param>
      </command_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="thr_T6">
      <command_interface name="effort">
        <param name="min">-40.0</param>
        <param name="max">40.0</param>
      </command_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="thr_T7">
      <command_interface name="effort">
        <param name="min">-40.0</param>
        <param name="max">40.0</param>
      </command_interface>
      <state_interface name="effort"/>
    </joint>
    <joint name="thr_T8">
      <command_interface name="effort">
        <param name="min">-40.0</param>
        <param name="max">40.0</param>
      </command_interface>
      <state_interface name="effort"/>
    </joint>

    <sensor name="imu_sensor">
      <state_interface name="orientation.w"/>
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>

    <sensor name="rov_odom">
      <state_interface name="pos.x"/>
      <state_interface name="pos.y"/>
      <state_interface name="pos.z"/>
      <state_interface name="quat.w"/>
      <state_interface name="quat.x"/>
      <state_interface name="quat.y"/>
      <state_interface name="quat.z"/>
      <state_interface name="vel_body.x"/>
      <state_interface name="vel_body.y"/>
      <state_interface name="vel_body.z"/>
    </sensor>

    <sensor name="pad_contact">
      <state_interface name="pad_TL/force"/>
      <state_interface name="pad_TR/force"/>
      <state_interface name="pad_BL/force"/>
      <state_interface name="pad_BR/force"/>
      <state_interface name="pad_TL/v_sep"/>
      <state_interface name="pad_TR/v_sep"/>
      <state_interface name="pad_BL/v_sep"/>
      <state_interface name="pad_BR/v_sep"/>
    </sensor>

    <!-- Phase 3.5 realistic noisy multi-rate sensors: a second, independent sensing path from
         the 3 ground-truth sensors above, consumed only by RovStateEstimator. -->
    <sensor name="imu_sensor_noisy">
      <state_interface name="orientation.w"/>
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
      <state_interface name="linear_acceleration.x"/>
      <state_interface name="linear_acceleration.y"/>
      <state_interface name="linear_acceleration.z"/>
    </sensor>

    <sensor name="depth_sensor_noisy">
      <state_interface name="z"/>
    </sensor>

    <sensor name="dvl_sensor_noisy">
      <state_interface name="vel.x"/>
      <state_interface name="vel.y"/>
      <state_interface name="vel.z"/>
      <state_interface name="range"/>
    </sensor>

    <sensor name="loadcell_noisy">
      <state_interface name="pad_TL/force"/>
      <state_interface name="pad_TR/force"/>
      <state_interface name="pad_BL/force"/>
      <state_interface name="pad_BR/force"/>
    </sensor>
  </ros2_control>

</robot>
