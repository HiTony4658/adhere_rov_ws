<?xml version="1.0"?>
<robot name="simplified_v1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Geometry mirrors mjcf/rov_wall.xml (and the read-only mujoco_mppi_ws reference) exactly:
    wall at world X=0, rov_base chassis box 0.2x0.6x0.4 m, 4 spherical contact pads at
    (-0.10, +/-0.25, +/-0.15) m, 8 thruster mount sites at X=0.0 with the same corner layout.
    All non-base links are rigidly fixed; the only real DOF is the world->base_link floating
    base, which is driven by AdhereMujocoHardware's free joint, not by any URDF joint.
  -->

  <material name="chassis_orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <material name="pad_red">
    <color rgba="1.0 0.1 0.1 1.0"/>
  </material>
  <material name="thruster_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="wall_grey">
    <color rgba="0.25 0.25 0.3 1.0"/>
  </material>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0.125 0 0.5" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2 0.6 0.4"/>
      </geometry>
      <material name="chassis_orange"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.6 0.4"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <inertia ixx="1.35" ixy="0.0" ixz="0.0" iyy="0.55" iyz="0.0" izz="1.10"/>
    </inertial>
  </link>

  <!-- 4 passive contact pads, spheres r=0.035, body-frame corner positions from rov_wall.xml -->
  <xacro:macro name="contact_pad" params="name x y z">
    <link name="${name}">
      <visual>
        <geometry>
          <sphere radius="0.035"/>
        </geometry>
        <material name="pad_red"/>
      </visual>
    </link>
    <joint name="base_to_${name}" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:contact_pad name="pad_TL" x="-0.1" y="0.25" z="0.15"/>
  <xacro:contact_pad name="pad_TR" x="-0.1" y="-0.25" z="0.15"/>
  <xacro:contact_pad name="pad_BL" x="-0.1" y="0.25" z="-0.15"/>
  <xacro:contact_pad name="pad_BR" x="-0.1" y="-0.25" z="-0.15"/>

  <!-- 8 thruster mount markers (small cylinders), sited at X=0.0 corners, matching
       thr_N1_site..thr_T8_site positions in rov_wall.xml. Orientation is cosmetic only
       (actual thrust directions are defined in the MJCF actuator gear vectors, not here). -->
  <xacro:macro name="thruster_marker" params="name x y z">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="0.02" length="0.05"/>
        </geometry>
        <material name="thruster_grey"/>
      </visual>
    </link>
    <joint name="base_to_${name}" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:thruster_marker name="thr_N1" x="0.0" y="0.25" z="0.15"/>
  <xacro:thruster_marker name="thr_N2" x="0.0" y="-0.25" z="0.15"/>
  <xacro:thruster_marker name="thr_N3" x="0.0" y="0.25" z="-0.15"/>
  <xacro:thruster_marker name="thr_N4" x="0.0" y="-0.25" z="-0.15"/>
  <xacro:thruster_marker name="thr_T5" x="0.0" y="0.25" z="0.15"/>
  <xacro:thruster_marker name="thr_T6" x="0.0" y="-0.25" z="0.15"/>
  <xacro:thruster_marker name="thr_T7" x="0.0" y="0.25" z="-0.15"/>
  <xacro:thruster_marker name="thr_T8" x="0.0" y="-0.25" z="-0.15"/>

  <!-- Static wall plane, world X=0, outward normal +X, matching the MJCF's wall body at X=-0.01 -->
  <link name="wall">
    <visual>
      <origin xyz="-0.01 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 4.0 4.0"/>
      </geometry>
      <material name="wall_grey"/>
    </visual>
  </link>
  <joint name="world_to_wall" type="fixed">
    <parent link="world"/>
    <child link="wall"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
