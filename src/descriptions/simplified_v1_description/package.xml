<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simplified_v1_description</name>
  <version>0.1.0</version>
  <description>
    URDF/Xacro (ros2_control tags) and MuJoCo MJCF (rov_wall.xml) description of the
    8-thruster thrust-adhered hull-inspection ROV, plus meshes, RViz configs, and
    ros2_control YAML parameter files.
  </description>
  <maintainer email="chesnuttbattiste@gmail.com">HiTony4658</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <!-- adhere_mujoco_hardware is referenced by name as a pluginlib hardware plugin from
       xacro/ros2_control.xacro, and in turn reads this package's mjcf/ share directory at
       runtime: a genuine mutual runtime coupling. It is intentionally left undeclared
       here (and on the other side) because declaring it in both package.xml files creates
       a build-order cycle colcon cannot resolve; pluginlib/ament_index resolve both
       directions purely from the installed package index, not from package.xml. -->
  <!-- launch/mujoco.launch.py (CLAUDE.md Phase 3.4: this package now owns the model's launch
       files, not adhere_mujoco_hardware/adhere_controller) runs adhere_mujoco_node and
       optionally includes adhere_teleop_gcs's teleop_gcs.launch.py and/or
       adhere_apriltag_detector_node (Phase 5.0 Stage 6), all referenced only by package name at
       runtime (get_package_share_directory / launch_ros Node(package=...)), never linked
       against: left undeclared for the same build-order-cycle reason as
       adhere_mujoco_hardware above. -->


  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
