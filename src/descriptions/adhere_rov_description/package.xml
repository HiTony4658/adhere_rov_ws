<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adhere_rov_description</name>
  <version>0.1.0</version>
  <description>
    URDF/Xacro (ros2_control tags) and MuJoCo MJCF (rov_wall.xml) description of the
    8-thruster thrust-adhered hull-inspection ROV, plus meshes, RViz configs, and
    ros2_control YAML parameter files.
  </description>
  <maintainer email="chesnuttbattiste@gmail.com">HiTony4658</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>adhere_mujoco_hardware</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
