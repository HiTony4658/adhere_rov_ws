Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Plane Cell Count: 20
      Cell Size: 0.5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /rov/odom
      Keep: 500
      Shape:
        Value: Axes
    - Class: rviz_default_plugins/MarkerArray
      Name: EnvironmentMarkers
      Enabled: true
      Topic:
        Value: /rov/environment_markers
  Global Options:
    Fixed Frame: world
    Background Color: 10; 14; 22
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Yaw: 1.0
      Pitch: 0.3
Window Geometry:
  Height: 900
  Width: 1400
