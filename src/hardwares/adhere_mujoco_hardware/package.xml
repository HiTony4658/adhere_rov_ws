<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adhere_mujoco_hardware</name>
  <version>0.1.0</version>
  <description>
    AdhereMujocoHardware: a 500Hz hardware_interface::SystemInterface (ROS 2 Foxy) that
    owns the master MuJoCo mjModel/mjData, FossenHydrodynamics, and the raw
    hw_states_[36]/hw_commands_[8] buffers. Encapsulates read() -&gt; write() (thruster
    lag/deadzone -&gt; Fossen hydrodynamics + wave gusts -&gt; mj_step) completely decoupled
    from the upper ROS 2 controller rate. Also hosts MujocoVisBridge, the in-process
    pointer bridge to the 60Hz MujocoViewer (GLFW/OpenGL) rendering frontend.
  </description>
  <maintainer email="chesnuttbattiste@gmail.com">HiTony4658</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>controller_manager</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>adhere_controller_common</depend>
  <!-- simplified_v1_description is read at runtime (ament_index_cpp::get_package_share_
       directory, for mjcf/rov_wall.xml) and in turn references this package by name as its
       ros2_control plugin: a mutual runtime coupling left undeclared on both sides to
       avoid a colcon build-order cycle (see simplified_v1_description/package.xml). -->
  <depend>eigen</depend>
  <depend>tf2_ros</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- MuJoCo (libmujoco) and GLFW3/OpenGL are located manually in CMakeLists.txt
       (no official find_package(mujoco) config is assumed); they are not declared here
       since they are not ROS packages. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <!-- test/test_fossen_hydrodynamics_geometry.cpp loads simplified_v1_description's real
       mjcf/rov_wall.xml via ament_index_cpp::get_package_share_directory() at test-run time
       (hydrodynamic-accuracy audit finding: this was previously undeclared, so an isolated,
       single-package colcon test invocation had no guarantee that package was already built).
       Declaring it as test_depend only (not depend/exec_depend) does NOT reintroduce the
       colcon build-order cycle documented above: simplified_v1_description's own package.xml
       declares zero dependency (of any kind) back on this package, so this is a
       one-directional edge, not a cycle. -->
  <test_depend>simplified_v1_description</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/adhere_mujoco_hardware.xml" />
  </export>
</package>
