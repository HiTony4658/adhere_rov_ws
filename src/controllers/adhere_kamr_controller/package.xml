<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adhere_kamr_controller</name>
  <version>0.1.0</version>
  <description>
    AdhereKamrController: a controller_interface::ControllerInterface (ROS 2 Foxy) plugin
    implementing the KAMR-MPPI multirate control stack. Manages the FSM (PASSIVE,
    PRELOAD_ATTACH, STATION_KEEPING, TRAJECTORY_TRACKING, EMERGENCY_DETACH), the 200Hz
    inner loop (Planar Impedance PD + Pad-Force DOB + 12D Elastic Rhombic-Kern OSQP),
    and the 20Hz asynchronous CUDA MPPI outer-loop rollout thread.
  </description>
  <maintainer email="chesnuttbattiste@gmail.com">HiTony4658</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>controller_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>eigen</depend>
  <depend>adhere_controller_common</depend>
  <depend>adhere_control_msgs</depend>

  <!-- TODO(Phase 2): add osqp/osqp-eigen and CUDA toolkit discovery in CMakeLists.txt
       once the 12D OSQP solve and the outer_mppi_cuda rollout kernels are implemented. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/adhere_kamr_controller.xml" />
  </export>
</package>
