<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>adhere_controller</name>
  <version>0.1.0</version>
  <description>
    AdhereController: the single unified controller_interface::ControllerInterface (ROS 2 Foxy)
    pluginlib plugin implementing the full FSM (PASSIVE, DEPTH_HOLD, OPEN_LOOP, PID_HOLD, and
    future KAMR-MPPI states), CtrlInterfaces (zero-copy LoanedStateInterface/
    LoanedCommandInterface wrapper), ModelParams (runtime-loaded, model-decoupled physical/gain
    parameters) and ThrusterAllocator (dynamic thruster allocation matrix), the uniform
    500Hz->250Hz/25Hz MultiRateDecimator, and mathTypes/mathTools. Merges the former
    adhere_controller_common + adhere_kamr_controller packages, which always built and deployed
    together with zero independent use.
  </description>
  <maintainer email="chesnuttbattiste@gmail.com">HiTony4658</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>controller_interface</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>eigen</depend>
  <depend>adhere_control_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- TODO(Phase 2): add osqp/osqp-eigen and CUDA toolkit discovery in CMakeLists.txt
       once the 12D OSQP solve and the outer_mppi_cuda rollout kernels are implemented. -->

  <!-- adhere_mujoco_hardware/adhere_teleop_gcs/simplified_v1_description/xacro/rviz2/
       robot_state_publisher were previously exec_depend here for this package's own closed-
       loop launch file; that launch file now lives in simplified_v1_description (CLAUDE.md
       Phase 3.4), which declares those deps itself. This package is discovered purely via
       pluginlib's ament-index plugin manifest at runtime: zero package.xml dependency back on
       it from any launch/teleop/description package (CLAUDE.md Phase 3.1.1 Stage 2.2). -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/adhere_controller.xml" />
  </export>
</package>
